<?php
// Prevent browser caching
header("Cache-Control: no-store, no-cache, must-revalidate, max-age=0");
header("Pragma: no-cache");

session_start();

// Ensure applicant data exists
if (!isset($_SESSION['applicant'])) {
    header('Location: index.php');
    exit;
}

$applicant = $_SESSION['applicant'];

// Handle career selection form submission
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action']) && $_POST['action'] === 'save_careers') {
    $selected_careers = $_POST['selected_careers'] ?? [];
    
    // Validate that exactly 3 careers are chosen
    if (count($selected_careers) === 3) {
        $_SESSION['selected_careers'] = $selected_careers;
        
        $currentTime = date('Y-m-d H:i:s');
        
        // Update persistent session / applicant record files
        $applicant['selected_careers'] = $selected_careers;
        $applicant['last_updated'] = $currentTime;
        $_SESSION['applicant'] = $applicant;
        
        $firstName = $applicant['first_name'] ?? '';
        $lastName = $applicant['last_name'] ?? '';
        $birthDate = $applicant['birth_date'] ?? '';
        $email = $applicant['email'] ?? '';
        
        $safeFirst = preg_replace('/[^a-zA-Z0-9_-]/', '', strtolower($firstName));
        $safeLast = preg_replace('/[^a-zA-Z0-9_-]/', '', strtolower($lastName));
        $safeEmail = preg_replace('/[^a-zA-Z0-9_-]/', '', strtolower($email));
        $personalizedFilename = "applicant_{$safeFirst}_{$safeLast}_{$safeEmail}.json";
        $historyFilename = "applicant_history.json";
        
        // Save to individual applicant JSON file
        file_put_contents($personalizedFilename, json_encode($applicant, JSON_PRETTY_PRINT));
        
        // Update global applicant_history.json file
        $historyData = [];
        if (file_exists($historyFilename)) {
            $decodedHistory = json_decode(file_get_contents($historyFilename), true);
            if (is_array($decodedHistory)) {
                $historyData = $decodedHistory;
            }
        }
        
        // Match record in history using name, email, and date of birth
        $foundIndex = -1;
        foreach ($historyData as $idx => $record) {
            if (
                strcasecmp(trim($record['first_name'] ?? ''), $firstName) === 0 &&
                strcasecmp(trim($record['last_name'] ?? ''), $lastName) === 0 &&
                trim($record['email'] ?? '') === $email &&
                trim($record['birth_date'] ?? '') === $birthDate
            ) {
                $foundIndex = $idx;
                break;
            }
        }
        
        if ($foundIndex !== -1) {
            $historyData[$foundIndex] = $applicant;
        } else {
            $historyData[] = $applicant;
        }
        
        file_put_contents($historyFilename, json_encode($historyData, JSON_PRETTY_PRINT));
        
        // Redirect to majors.php upon choosing the 3rd career
        header('Location: majors.php');
        exit;
    } else {
        $error_message = "Please select exactly 3 careers before continuing to majors.";
    }
}

// Load degrees.json
$jsonFile = 'degrees.json';
$degrees_data = [];
if (file_exists($jsonFile)) {
    $raw_json = file_get_contents($jsonFile);
    $decoded = json_decode($raw_json, true);
    if (is_array($decoded)) {
        $degrees_data = $decoded;
    }
}

// Extract applicant filters
$goal = $applicant['goal'] ?? 'interests';
$lcp = $applicant['lcp'] ?? 'Undecided';
$top_codes = $applicant['interest_inventory']['top_codes'] ?? [];
$primary_code = !empty($top_codes) ? $top_codes[0] : '';

// Fallback logic for undecided LCP
if (strcasecmp($lcp, 'Undecided') === 0 || empty($lcp)) {
    $goal = 'interests';
}

// Filter careers based on user goal and LCP / RIASEC rules
$matching_careers = [];

foreach ($degrees_data as $item) {
    $career_list = $item['careers'] ?? [$item];
    
    foreach ($career_list as $career) {
        $item_lcp = $career['lcp'] ?? $item['lcp'] ?? '';
        $item_code = $career['riasec_code'] ?? $career['code'] ?? $item['riasec_code'] ?? '';
        $item_salary = $career['median_salary'] ?? $item['median_salary'] ?? '';
        $item_growth = $career['growth_rate'] ?? $item['growth_rate'] ?? '';
        $item_type = $career['type'] ?? $item['type'] ?? '';
        
        $is_match = false;
        
        switch ($goal) {
            case 'interests':
                if (!empty($primary_code) && (strcasecmp($item_code, $primary_code) === 0 || (is_array($top_codes) && in_array($item_code, $top_codes)))) {
                    $is_match = true;
                }
                break;
                
            case 'high_earning':
                if (strcasecmp($item_lcp, $lcp) === 0 && strcasecmp($item_salary, 'High') === 0) {
                    $is_match = true;
                }
                break;
                
            case 'growth_potential':
                if (strcasecmp($item_lcp, $lcp) === 0 && strcasecmp($item_growth, 'High') === 0) {
                    $is_match = true;
                }
                break;
                
            case 'start_quickly':
                if (strcasecmp($item_lcp, $lcp) === 0 && (strcasecmp($item_type, 'certificate') === 0 || stripos($item_type, 'cert') !== false)) {
                    $is_match = true;
                }
                break;
                
            default:
                if (!empty($primary_code) && strcasecmp($item_code, $primary_code) === 0) {
                    $is_match = true;
                }
                break;
        }
        
        if ($is_match) {
            $matching_careers[] = [
                'title' => $career['title'] ?? $career['name'] ?? 'Career Option',
                'lcp' => $item_lcp,
                'median_salary' => $item_salary,
                'growth_rate' => $item_growth,
                'description' => $career['description'] ?? 'No description available.',
                'riasec_code' => $item_code
            ];
        }
    }
}

if (empty($matching_careers) && !empty($degrees_data)) {
    foreach ($degrees_data as $item) {
        $matching_careers[] = [
            'title' => $item['title'] ?? $item['name'] ?? 'General Career Pathway',
            'lcp' => $item['lcp'] ?? $lcp,
            'median_salary' => $item['median_salary'] ?? 'Moderate',
            'growth_rate' => $item['growth_rate'] ?? 'Stable',
            'description' => $item['description'] ?? 'Explore rewarding career opportunities in this pathway.',
            'riasec_code' => $item['riasec_code'] ?? 'A'
        ];
    }
}
?>
