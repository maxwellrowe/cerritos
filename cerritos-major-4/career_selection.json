<script>
function updateCount() {
    const checkboxes = document.querySelectorAll('#checkbox-container input[type="checkbox"]:checked');
    const countDisplay = document.getElementById('selected-count');
    const submitBtn = document.getElementById('submit-btn');
    const count = checkboxes.length;

    countDisplay.textContent = count;
    submitBtn.disabled = (count !== 3);

    const allCheckboxes = document.querySelectorAll('#checkbox-container input[type="checkbox"]');
    allCheckboxes.forEach(cb => {
        if (!cb.checked && count >= 3) {
            cb.disabled = true;
        } else {
            cb.disabled = false;
        }
    });
}

function filterList() {
    const input = document.getElementById('title-filter');
    const filter = input.value.toLowerCase();
    const items = document.querySelectorAll('.title-item');

    items.forEach(item => {
        const text = item.textContent || item.innerText;
        item.style.display = text.toLowerCase().includes(filter) ? "" : "none";
    });
}
</script>

