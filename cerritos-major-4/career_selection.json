<?php
session_start();

// 1. Path to JSON configuration
$jsonFilePath = __DIR__ . '/degrees.json';

// Fetch session variables (with fallbacks)
$userPathway = $_SESSION['pathway'] ?? 'Exploration & Discovery';
$userGoals   = $_SESSION['goals']   ?? [];
$userRiasec  = $_SESSION['riasec']  ?? null; // Fetch RIASEC score from session if available

// Array to hold diagnostic messages
$debugLogs = [];
$totalTitleKeysFound = 0;
$passedPathwayCheck  = 0;
$passedGoalCheck     = 0;

// Load and validate JSON file
if (!file_exists($jsonFilePath)) {
    $debugLogs[] = ['type' => 'error', 'msg' => "CRITICAL FAIL: File 'degrees.json' not found at path: " . $jsonFilePath];
    $data = [];
} else {
    $jsonContent = file_get_contents($jsonFilePath);
    $data = json_decode($jsonContent, true);

    if (json_last_error() !== JSON_ERROR_NONE) {
        $debugLogs[] = ['type' => 'error', 'msg' => "CRITICAL FAIL: Invalid JSON structure - " . json_last_error_msg()];
        $data = [];
    }
}

/**
 * Diagnostic function to trace title exclusions
 */
function runTitleExclusionDiagnostics(array $item, $targetPathway, array $targetGoals, $targetRiasec, &$debugLogs, &$totalTitleKeysFound, &$passedPathwayCheck, &$passedGoalCheck, $parentPathway = null, $parentRiasec = null): void {
    if (!is_array($item)) return;

    // Detect explicit pathway or inherited parent pathway
    $currentPathway = $item['pathway'] ?? $parentPathway;
    
    // Detect explicit RIASEC code or inherited parent RIASEC code
    $currentRiasec = $item['riasec_code'] ?? $parentRiasec;

    // Check condition: Use RIASEC filtering ONLY when pathway is Exploration & Discovery OR goals contain "interests"
    $isExplorationPathway = (strcasecmp(trim($targetPathway), 'Exploration and Discovery') === 0 || strcasecmp(trim($targetPathway), 'Exploration & Discovery') === 0);
    $hasInterestsGoal = in_array('interests', array_map('strtolower', $targetGoals));
    
    $useRiasecFilter = ($isExplorationPathway || $hasInterestsGoal);

    foreach ($item as $key => $value) {
        if ($key === 'title' && is_string($value)) {
            $totalTitleKeysFound++;
            $titleName = trim($value);
            $pathwayMatched = false;

            // Diagnostic Check 1: Pathway Alignment
            if ($currentPathway === null) {
                $debugLogs[] = [
                    'type' => 'exclude',
                    'msg'  => "EXCLUDED '{$titleName}' &rarr; Reason: No 'pathway' key found on this title or its parent objects."
                ];
            } elseif (strcasecmp(trim($currentPathway), trim($targetPathway)) !== 0) {
                $debugLogs[] = [
                    'type' => 'exclude',
                    'msg'  => "EXCLUDED '{$titleName}' &rarr; Reason: Pathway mismatch. (Object has: '{$currentPathway}' | User Session has: '{$targetPathway}')"
                ];
            } else {
                $pathwayMatched = true;
                $passedPathwayCheck++;
            }

            // Diagnostic Check 2: Criteria Alignment (RIASEC vs standard Goals)
            if ($pathwayMatched) {
                if ($useRiasecFilter) {
                    // RIASEC validation logic
                    if ($currentRiasec !== null && $targetRiasec !== null && strcasecmp(trim($currentRiasec), trim($targetRiasec)) === 0) {
                        $passedGoalCheck++;
                        $debugLogs[] = [
                            'type' => 'keep',
                            'msg'  => "PASSED '{$titleName}' &rarr; Matched pathway and RIASEC code ('{$targetRiasec}')."
                        ];
                    } else {
                        $debugLogs[] = [
                            'type' => 'exclude',
                            'msg'  => "EXCLUDED '{$titleName}' &rarr; Reason: RIASEC filter active but code mismatch. (Object has: '{$currentRiasec}' | User Session has: '{$targetRiasec}')"
                        ];
                    }
                } else {
                    // Standard Goals validation logic
                    if (isset($item['goals']) && is_array($item['goals'])) {
                        $hasMatchingGoal = false;
                        foreach ($targetGoals as $goal) {
                            if (in_array($goal, $item['goals'])) {
                                $hasMatchingGoal = true;
                                break;
                            }
                        }

                        if (!$hasMatchingGoal) {
                            $debugLogs[] = [
                                'type' => 'exclude',
                                'msg'  => "EXCLUDED '{$titleName}' &rarr; Reason: Goals array exists on object, but none matched user goals (" . json_encode($targetGoals) . ")."
                            ];
                        } else {
                            $passedGoalCheck++;
                            $debugLogs[] = [
                                'type' => 'keep',
                                'msg'  => "PASSED '{$titleName}' &rarr; Matched both pathway and criteria."
                            ];
                        }
                    } else {
                        $debugLogs[] = [
                            'type' => 'exclude',
                            'msg'  => "EXCLUDED '{$titleName}' &rarr; Reason: Pathway matched, but no 'goals' array attached to this specific title entry."
                        ];
                    }
                }
            }

        } elseif (is_array($value)) {
            runTitleExclusionDiagnostics($value, $targetPathway, $targetGoals, $targetRiasec, $debugLogs, $totalTitleKeysFound, $passedPathwayCheck, $passedGoalCheck, $currentPathway, $currentRiasec);
        }
    }
}

// Execute diagnostics
if (!empty($data)) {
    runTitleExclusionDiagnostics($data, $userPathway, $userGoals, $userRiasec, $debugLogs, $totalTitleKeysFound, $passedPathwayCheck, $passedGoalCheck);
}

/**
 * Fallback Function: Extract ALL 199 unique titles recursively (ignoring rigid filters)
 */
function extractAll199Titles(array $array, array &$results): void {
    foreach ($array as $key => $value) {
        if ($key === 'title' && is_string($value)) {
            $trimmed = trim($value);
            if (!empty($trimmed)) {
                $results[] = $trimmed;
            }
        } elseif (is_array($value)) {
            extractAll199Titles($value, $results);
        }
    }
}

$rawTitles = [];
extractAll199Titles($data, $rawTitles);
$all199UniqueTitles = array_values(array_unique($rawTitles));
natcasesort($all199UniqueTitles);
$all199UniqueTitles = array_values($all199UniqueTitles);

// Handle Form Submission
$errorMsg = '';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $selectedCareers = $_POST['careers'] ?? [];
    if (count($selectedCareers) === 3) {
        $_SESSION['selected_careers'] = $selectedCareers;
        header('Location: major_recommendations.php');
        exit;
    } else {
        $errorMsg = 'Please select exactly 3 choices before proceeding.';
    }
}
